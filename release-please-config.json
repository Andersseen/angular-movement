{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "projects/movement": {
      "release-type": "node",
      "package-name": "angular-movement",
      "component": "angular-movement",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "skip-changelog": true,
      "pull-request-title-pattern": "chore(release): angular-movement v${version}",
      "draft": true,
      "force-tag-creation": true
    }
  }
}
