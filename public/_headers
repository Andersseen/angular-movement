# Cloudflare Pages response headers (also applied by `wrangler pages dev`, so e2e-static covers them).
# No CSP yet: the theme bootstrap in index.html is an inline script, and a CSP that has to allow it
# would add little. Revisit together with a nonce or hash for that script.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Vite emits content-hashed file names here: a changed file is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
