{
  "mcpServers": {
    "codebase-memory": {
      "args": [],
      "command": "codebase-memory-mcp",
      "env": {},
      "type": "stdio"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "memory": {
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "command": "npx",
      "env": {
        "MEMORY_FILE_PATH": "${HOME}/.claude/memory/angular-movement-kg.json"
      }
    },
    "playwright": {
      "args": ["@playwright/mcp@0.0.81"],
      "command": "npx",
      "env": {},
      "type": "stdio"
    }
  }
}
