{
  "name": "angular-movement-project",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "pnpm exec vite",
    "dev": "pnpm exec vite",
    "build": "pnpm exec vite build && pnpm run build:finalize",
    "build:prod": "pnpm exec vite build --mode production && pnpm run build:finalize",
    "build:finalize": "doq-search index dist/analog/public && node scripts/finalize-site.mjs",
    "preview": "pnpm exec vite preview",
    "watch": "pnpm exec vite build --watch",
    "test": "ng test movement",
    "test:coverage": "ng test movement --coverage --watch=false",
    "test:site": "ng test angular-movement",
    "test:site:coverage": "ng test angular-movement --coverage --watch=false",
    "e2e": "playwright test",
    "cf:login": "pnpm exec wrangler login",
    "cf:whoami": "pnpm exec wrangler whoami",
    "deploy:cloudflare": "pnpm run build:prod && pnpm exec wrangler pages deploy dist/analog/public --project-name=angular-movement",
    "deploy": "pnpm run deploy:cloudflare",
    "pack:check": "ng build movement && pnpm --dir dist/movement pack --dry-run",
    "lint": "ng lint",
    "docs:check": "node scripts/check-docs-drift.mjs",
    "docs:snippets": "ngc -p tsconfig.snippets.json",
    "docs:api": "doq-api generate --project projects/movement/tsconfig.lib.json --entry projects/movement/src/public-api.ts --content-dir src/content/docs --out src/content/docs/reference --base-path /docs --group Reference --title 'API reference'",
    "docs:api:check": "doq-api check --project projects/movement/tsconfig.lib.json --entry projects/movement/src/public-api.ts --content-dir src/content/docs --out src/content/docs/reference --base-path /docs --group Reference --title 'API reference'",
    "docs:content": "doq content generate",
    "docs:content:check": "doq content check",
    "docs:sync": "pnpm run docs:api && pnpm run docs:content",
    "docs:verify": "pnpm run docs:snippets && pnpm run docs:api:check && pnpm run docs:content:check && pnpm run docs:check && doq doctor",
    "test:scripts": "node --test scripts/lib/*.test.mjs scripts/release/*.test.mjs scripts/*.test.mjs",
    "validate:consumer": "node scripts/validate-consumer.mjs",
    "validate:consumer:runtime": "node scripts/validate-consumer-runtime.mjs",
    "api:snapshot": "ng build movement && node scripts/update-api-snapshot.mjs",
    "api:check": "ng build movement && node scripts/check-api-snapshot.mjs",
    "contracts:check": "node scripts/check-contract-inventory.mjs",
    "mcp:install": "pnpm --dir projects/movement-mcp install",
    "mcp:snapshot": "node projects/movement-mcp/scripts/generate-snapshot.mjs",
    "mcp:build": "pnpm --dir projects/movement-mcp run build",
    "mcp:test": "pnpm --dir projects/movement-mcp run test",
    "mcp:pack:check": "pnpm --dir projects/movement-mcp run build && pnpm --dir projects/movement-mcp pack --dry-run",
    "mcp:publish": "pnpm --dir projects/movement-mcp run build && cd projects/movement-mcp && pnpm publish --no-git-checks",
    "prepare": "husky",
    "format:check": "prettier --check 'projects/movement/**/*.{ts,html,css,json}' 'src/**/*.{ts,html,css}' 'e2e/**/*.ts' 'e2e-static/**/*.ts' 'playwright*.ts' 'scripts/**/*.mjs' '.github/**/*.yml' release-please-config.json .release-please-manifest.json",
    "format": "prettier --write '**/*.{ts,html,css,scss,md,json}'",
    "migrate:build": "tsc -p projects/movement-migrate/tsconfig.json",
    "migrate:test": "vitest run --root projects/movement-migrate",
    "migrate:assess": "node projects/movement-migrate/dist/cli.js",
    "e2e:static": "playwright test -c playwright.static.config.ts"
  },
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@analogjs/content": "^2.9.1",
    "@analogjs/platform": "^2.9.1",
    "@analogjs/router": "^2.9.1",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@doqs/analog": "0.11.0",
    "@voltui/components": "^1.2.0",
    "lumen-icons": "^0.2.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@agentyx/cli": "^0.9.0",
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/dom": "^10.4.1",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "ng-packagr": "^22.2.4",
    "pagefind": "1.5.2",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "release-please": "17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "wrangler": "^4.140.0",
    "yaml": "^2.9.1",
    "zone.js": "^0.16.1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.html": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,scss,less,md,json}": [
      "prettier --write"
    ]
  }
}
